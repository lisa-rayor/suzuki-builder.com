{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "サイトを起動",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "-d"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "サイトを停止",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "down"
      ],
      "problemMatcher": []
    },
    {
      "label": "サイトの状態",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "ps"
      ],
      "problemMatcher": []
    }
  ]
}
